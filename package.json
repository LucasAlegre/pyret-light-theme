{
  "name": "pyret-vscode-theme",
  "displayName": "Pyret VSCode Theme",
  "description": "Syntax highlighting and color themes for Pyret (.arr) files. Uses the real Pyret tokenizer with scope tracking for parameters, types, functions, keywords, and comments. Includes both Pyret Light and Pyret Dark (One Dark Pro) color themes.",
  "version": "1.2.1",
  "publisher": "LucasAlegre",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasAlegre/pyret-light-theme.git"
  },
  "homepage": "https://github.com/LucasAlegre/pyret-light-theme",
  "bugs": {
    "url": "https://github.com/LucasAlegre/pyret-light-theme/issues"
  },
  "keywords": ["pyret", "syntax", "theme", "highlighting", "arr", "one dark pro", "dark theme", "parameters"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Themes"],
  "contributes": {
    "languages": [
      {
        "id": "pyret",
        "aliases": ["Pyret", "pyret"],
        "extensions": [".arr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pyret",
        "scopeName": "source.pyret",
        "path": "./syntaxes/pyret.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Pyret Light",
        "uiTheme": "vs",
        "path": "./themes/pyret-light-color-theme.json"
      },
      {
        "label": "Pyret Dark (One Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/pyret-dark-color-theme.json"
      }
    ]
  },
  "main": "./extension.js"
}
